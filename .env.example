NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
DATABASE_URL=postgresql://dei_app:replace-me@localhost:5432/dei_analytics
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HRIS_PROVIDER_URL=
ATS_PROVIDER_URL=
PAYROLL_PROVIDER_URL=
